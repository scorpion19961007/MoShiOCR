<Window x:Class="MoShiOCR.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="百度 API 设置" Width="650" Height="720" MinWidth="590" MinHeight="560" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="百度 API 设置" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="OCR 与翻译使用两套独立凭据" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,16">
            <StackPanel>
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B0;" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="百度智能云 OCR" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="API Key" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0"/>
                <PasswordBox x:Name="OcrApiKeyBox" Margin="0,7,0,0" Padding="10" BorderBrush="{StaticResource LineBrush}"/>
                <TextBlock Text="Secret Key" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,0"/>
                <PasswordBox x:Name="OcrSecretKeyBox" Margin="0,7,0,0" Padding="10" BorderBrush="{StaticResource LineBrush}"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="识别接口" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="OcrModeCombo" Grid.Column="1">
                        <ComboBoxItem Content="标准版" Tag="general_basic"/><ComboBoxItem Content="高精度版" Tag="accurate_basic"/>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TestOcrButton" Style="{StaticResource GhostButton}" Content="测试 OCR" Click="TestOcr_Click"/>
                        <TextBlock x:Name="OcrTestStatus" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Background="#FFF1E9" CornerRadius="5" Padding="12,9" Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C1;" Foreground="{StaticResource WarmBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="百度翻译开放平台" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="APP ID" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0"/>
                <TextBox x:Name="TranslateAppIdBox" Margin="0,7,0,0"/>
                <TextBlock Text="密钥" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,0"/>
                <PasswordBox x:Name="TranslateSecretBox" Margin="0,7,0,0" Padding="10" BorderBrush="{StaticResource LineBrush}"/>
                <Grid Margin="0,12,0,0">
                    <TextBlock Text="使用通用文本翻译 API，源语言自动检测" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TestTranslateButton" Style="{StaticResource GhostButton}" Content="测试翻译" Click="TestTranslate_Click"/>
                        <TextBlock x:Name="TranslateTestStatus" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Background="#F1F3F0" CornerRadius="5" Padding="12,9" Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE765;" Foreground="{StaticResource InkBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="全局快捷键" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="截图识别" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,9"/>
                    <TextBox x:Name="ScreenshotHotkeyBox" Grid.Column="1" Margin="0,0,0,9" IsReadOnly="True" TextAlignment="Center" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" ToolTip="点击后按下组合键；按 Backspace 或 Delete 可禁用"/>
                    <TextBlock Grid.Row="1" Text="识别图片" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,9"/>
                    <TextBox x:Name="RecognitionHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,9" IsReadOnly="True" TextAlignment="Center" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" ToolTip="点击后按下组合键；按 Backspace 或 Delete 可禁用"/>
                    <TextBlock Grid.Row="2" Text="翻译文本" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="TranslationHotkeyBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" TextAlignment="Center" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" ToolTip="点击后按下组合键；按 Backspace 或 Delete 可禁用"/>
                </Grid>
                <TextBlock Text="应用运行时全局生效" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="95,8,0,0"/>

                <TextBlock Text="所有凭据均保存在 Windows 凭据管理器，不会写入配置文件。" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="保存设置" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
