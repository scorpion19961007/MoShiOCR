<Window x:Class="MoShiOCR.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="墨识截图" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Fill"/>
        <Canvas x:Name="Overlay">
            <Path x:Name="DimPath" Fill="#88000000" IsHitTestVisible="False"/>
            <Border x:Name="SelectionBorder" Visibility="Collapsed" BorderBrush="White" BorderThickness="2" Background="#08FFFFFF" IsHitTestVisible="False"/>
            <Border x:Name="SizeBadge" Visibility="Collapsed" Background="#E817211B" CornerRadius="4" Padding="8,5" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="11"/>
            </Border>
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" Background="#E817211B" CornerRadius="5" Padding="14,8" IsHitTestVisible="False">
            <TextBlock Text="拖动框选识别区域  ·  Esc 取消" Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</Window>
