<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MoShiOCR</AssemblyName>
    <RootNamespace>MoShiOCR</RootNamespace>
    <Version>1.6.0</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>墨识 OCR</AssemblyTitle>
    <Description>支持百度 OCR 与百度翻译的 Windows 截图识别工具</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TencentCloudSDK.Ocr" Version="3.0.1495" />
  </ItemGroup>
</Project>
